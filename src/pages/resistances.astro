---
import Base from '../layouts/Base.astro';
import data from '../data/resistances.json';
import type { ReferenceSheet } from '../data/types';
import '../styles/reference.css';

const sheet = data as ReferenceSheet;
---

<Base title={`PoE2 ${sheet.title} — Cheatsheet (Patch ${sheet.patch})`}>
  <div class="container">
    <section class="sheet-hero">
      <h1 class="sheet-title">{sheet.title}</h1>
      <div class="badges">
        <span class="pill">Patch {sheet.patch}</span>
        <span class="pill">Verified {sheet.lastVerified}</span>
      </div>
      <p class="intro">{sheet.intro}</p>
    </section>

    {
      sheet.sections.map((s) => (
        <section class="ref-section" id={s.id}>
          <h2 class="ref-heading">{s.heading}</h2>
          {s.blurb && <p class="ref-blurb">{s.blurb}</p>}

          {s.table && (
            <div class="table-wrap">
              <table class="ref-table">
                <thead>
                  <tr>
                    {s.table.columns.map((c) => (
                      <th>{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {s.table.rows.map((row) => (
                    <tr>
                      {row.map((cell, i) => (
                        <td data-label={s.table!.columns[i]}>{cell}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {s.cards && (
            <div class="ref-cards">
              {s.cards.map((c) => (
                <article class={`ref-card ${c.flag === 'warn' ? 'warn' : ''}`}>
                  <div class="ref-card-head">
                    <h3>{c.title}</h3>
                    {c.value && <span class="ref-card-value">{c.value}</span>}
                  </div>
                  <p>{c.body}</p>
                </article>
              ))}
            </div>
          )}

          {s.note && <p class="ref-note">{s.note}</p>}
        </section>
      ))
    }
  </div>
</Base>
