---
import Base from '../layouts/Base.astro';
import { SHEETS } from '../data/sheets';

const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (slug: string) => (slug ? `${baseNoSlash}/${slug}` : `${baseNoSlash}/`);
---

<Base title="PoE2 Cheatsheets — fast quick references for Path of Exile 2">
  <div class="container">
    <section class="sheet-hero">
      <h1 class="sheet-title">Path of Exile 2 Cheatsheets</h1>
      <p class="intro">
        Fast, mobile-friendly quick references for Path of Exile 2 (patch 0.5, Return of the
        Ancients). Hand-curated and easy to update as the game changes. Pick a sheet:
      </p>
    </section>

    <div class="sheet-grid">
      {
        SHEETS.map((s) => (
          <a class="sheet-card" href={href(s.slug)}>
            <div class="sheet-card-head">
              <h2>{s.title}</h2>
              {s.status === 'soon' && <span class="pill">Soon</span>}
            </div>
            <p>{s.blurb}</p>
            <span class="sheet-card-go">Open →</span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
